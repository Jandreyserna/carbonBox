{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["DOM" ,"ES2021"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": "./src",
    "paths": {
      "@domain/*": ["document-processing/domain/*"],
      "@application/*": ["document-processing/application/*"],
      "@infrastructure/*": ["document-processing/infrastructure/*"],
      "@presentation/*": ["document-processing/presentation/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}